<?xml version="1.0" encoding="utf-8"?>
<!--
  Guardian adaptive-icon background.

  A flat diagonal gradient in the Guardian brand colours. Adaptive icon layers are
  108x108dp with only the central 72x72dp guaranteed visible, so the background is
  a full-bleed fill with no detail that can be cropped away by a device mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item
                    android:color="#FF6C63FF"
                    android:offset="0.0" />
                <item
                    android:color="#FF3B3A8C"
                    android:offset="0.55" />
                <item
                    android:color="#FF1B1D22"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
