<?xml version="1.0" encoding="utf-8"?>
<!--
  Guardian adaptive-icon foreground: a protective shield enclosing a location pin.

  Drawn inside the central 72x72dp safe zone of the 108x108dp layer (roughly
  x/y 18..90) so no device mask - circle, squircle, rounded square - can clip the
  symbol. Solid white for maximum contrast on the brand gradient, and it doubles
  as the monochrome themed-icon layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield outline: flat top, tapering to a point at the bottom. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,25.5L30.5,34.2v19.9c0,14.6 9.8,28.2 23.5,32.4c13.7,-4.2 23.5,-17.8 23.5,-32.4V34.2L54,25.5zM54,32.9l16.9,6.2v15c0,11.4 -7.2,22 -16.9,25.7c-9.7,-3.7 -16.9,-14.3 -16.9,-25.7v-15L54,32.9z" />

    <!-- Location pin inside the shield: teardrop body. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,42.2c-6.1,0 -11,4.9 -11,11c0,8.2 11,19.4 11,19.4s11,-11.2 11,-19.4C65,47.1 60.1,42.2 54,42.2z" />

    <!-- Pin centre, punched out so the pin reads clearly at small sizes. -->
    <path
        android:fillColor="#FF1B1D22"
        android:pathData="M54,49.1c-2.3,0 -4.1,1.8 -4.1,4.1c0,2.3 1.8,4.1 4.1,4.1c2.3,0 4.1,-1.8 4.1,-4.1C58.1,50.9 56.3,49.1 54,49.1z" />
</vector>
