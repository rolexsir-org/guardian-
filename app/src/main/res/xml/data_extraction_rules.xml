<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ data-extraction rules.

   Cloud backup excludes the encrypted safety database, the encrypted preference
   store and cached evidence, matching backup_rules.xml. Device transfer is
   excluded for the database too: its key lives in this device's keystore, so the
   copy would be unreadable and must not be presented to the user as restored data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="guardian_database" />
        <exclude domain="database" path="guardian_database-wal" />
        <exclude domain="database" path="guardian_database-shm" />
        <exclude domain="sharedpref" path="guardian_secure_prefs_v2.xml" />
        <exclude domain="file" path="evidence" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="guardian_database" />
        <exclude domain="sharedpref" path="guardian_secure_prefs_v2.xml" />
        <exclude domain="file" path="evidence" />
    </device-transfer>
</data-extraction-rules>
