<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access to the Guardian Cloudflare Worker (HTTPS only). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Live location sharing during check-ins and emergencies. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Direct emergency calling / SMS broadcast. Requested at the moment the
         user enables the feature, with an explanation and a degraded fallback. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Emergency alerts and risk-area notifications (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Hands-free voice SOS requires microphone access; the feature is opt-in
         and the permission is requested only when the user switches it on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Device-credential / biometric confirmation for protected screens.
         USE_FINGERPRINT covers API 24-27, USE_BIOMETRIC covers API 28+. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:targetApi="23" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
        Android 11 (API 30) package visibility.

        Without these declarations `resolveActivity` returns null for apps that
        exist, which would make Guardian tell the user "no dialler app is
        available" during an emergency. Only the handlers Guardian actually
        hands off to are declared — no broad QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <!-- Emergency calling and the dialler fallback. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
        <!-- Emergency SMS composer fallback when SEND_SMS is not granted. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Sharing an emergency location through the system share sheet. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Showing an emergency location on a map, then a browser fallback. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Hands-free voice SOS uses the platform speech recogniser. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".GuardianApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Guardian"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Guardian">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
