# ============================================================================
# Guardian — environment template
# ============================================================================
# Copy this file to `.env` and fill in REAL values. `.env` is git ignored.
# Never commit real credentials. Empty values mean "not configured": the
# Android build still compiles, and features that need the value stay disabled
# (the app never falls back to fabricated endpoints, keys or identities).
# ============================================================================

# ---------------------------------------------------------------------------
# Cloudflare backend (Guardian API)
# ---------------------------------------------------------------------------
# Public HTTPS URL of the deployed Worker, e.g. https://guardian-api.<account>.workers.dev
CLOUDFLARE_WORKER_URL=

# Operator-only values. They are used for deploying the backend
# (`cd cloudflare`), never shipped inside the Android app.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
R2_BUCKET_NAME=

# HMAC secret for access/refresh tokens. Generate with:
#   openssl rand -base64 48
# Set it as a Worker secret: npx wrangler secret put AUTH_SECRET
AUTH_SECRET=

# ---------------------------------------------------------------------------
# RevenueCat (subscriptions — independent from the Guardian backend)
# ---------------------------------------------------------------------------
# Android public SDK key (safe to embed in the app), never a secret key.
REVENUECAT_ANDROID_API_KEY=
# Entitlement identifier configured in the RevenueCat dashboard.
REVENUECAT_ENTITLEMENT_ID=

# ---------------------------------------------------------------------------
# Android signing (release builds)
# ---------------------------------------------------------------------------
KEYSTORE_PATH=
STORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
